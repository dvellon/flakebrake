{
  "name": "flakebrake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcp:all": "npm run build --silent && node dist/src/mcp-cli.js --all",
    "mcp:serve": "npm run build --silent && node dist/src/mcp-cli.js",
    "m4:mission": "npm run build --silent && node dist/src/m4-cli.js",
    "m4:live": "npm run build --silent && node dist/src/m4-cli.js --live",
    "test": "npm run build --silent && node --test --experimental-test-isolation=none dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@truefoundry/trueforge": "0.1.4",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "zod": "3.25.76"
  }
}
